# Vite app config
VITE_API_URL=/api
VITE_AUTH_BASE_URL=/api
VITE_AI_PROXY_URL=/api
VITE_TRIPS_API_URL=/api
VITE_USE_MOCK=false

# Same-origin Cloudflare Pages proxy / local dev proxy
API_ORIGIN=https://lyjuidar2e.execute-api.us-east-1.amazonaws.com/production



# Cognito hosted-UI OAuth
# IMPORTANT: the exact value below must be added to Cognito's allowed callback URLs.
# Use the deployed callback for production, or localhost:3000 for local dev.
VITE_COGNITO_DOMAIN=<your-cognito-domain>.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<your-client-id>
VITE_OAUTH_REDIRECT_URI=https://findmytour.ai/api/auth/oauth/callback

# Optional legacy compatibility names
REACT_APP_API_URL=/api
REACT_APP_AUTH_BASE_URL=/api
REACT_APP_AI_PROXY_URL=/api
REACT_APP_TRIPS_API_URL=/api
REACT_APP_USE_MOCK=false
