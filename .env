# API routes are served same-origin via /api and proxied to the deployed auth/trips/AI backend.
VITE_API_URL=/api
VITE_AUTH_BASE_URL=/api
VITE_AI_PROXY_URL=/api
VITE_TRIPS_API_URL=/api
VITE_USE_MOCK=false

# Same-origin Cloudflare Pages proxy / local dev proxy
API_ORIGIN=https://lyjuidar2e.execute-api.us-east-1.amazonaws.com/production

# Cognito hosted-UI OAuth (social login code exchange in the browser)
# IMPORTANT: this exact callback must be registered in the Cognito app client.
# Production (active domain): https://findmytour.ai/api/auth/oauth/callback
# Legacy: https://exploreragents.com/api/auth/oauth/callback
# Local: http://localhost:3000/api/auth/oauth/callback
VITE_COGNITO_DOMAIN=explorer-agent-production.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=jsffkjhgff1ejh3sodu3ohscc
VITE_OAUTH_REDIRECT_URI=https://findmytour.ai/api/auth/oauth/callback

# Optional legacy compatibility names
REACT_APP_API_URL=/api
REACT_APP_AUTH_BASE_URL=/api
REACT_APP_AI_PROXY_URL=/api
REACT_APP_TRIPS_API_URL=/api
REACT_APP_USE_MOCK=false